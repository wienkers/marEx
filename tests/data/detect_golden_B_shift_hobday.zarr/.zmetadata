{
    "metadata": {
        ".zattrs": {
            "max_anomaly": 5.0,
            "method_anomaly": "shifting_baseline",
            "method_extreme": "hobday_extreme",
            "method_percentile": "approximate",
            "precision": 0.01,
            "preprocessing_steps": [
                "Rolling climatology using 5 years",
                "Smoothed with 11-day window",
                "Day-of-year thresholds with 3 day window & 5 spatial neighbours"
            ],
            "smooth_days_baseline": 11,
            "threshold_percentile": 95,
            "window_days_hobday": 3,
            "window_spatial_hobday": 5,
            "window_year_baseline": 5
        },
        ".zgroup": {
            "zarr_format": 2
        },
        "dat_anomaly/.zarray": {
            "chunks": [
                366,
                10,
                20
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                732,
                20,
                40
            ],
            "zarr_format": 2
        },
        "dat_anomaly/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "time",
                "lat",
                "lon"
            ]
        },
        "dayofyear/.zarray": {
            "chunks": [
                366
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<u2",
            "fill_value": null,
            "filters": null,
            "order": "C",
            "shape": [
                366
            ],
            "zarr_format": 2
        },
        "dayofyear/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "dayofyear"
            ],
            "axis": "T",
            "comment": "",
            "long_name": "reference time of sst field",
            "standard_name": "time"
        },
        "extreme_events/.zarray": {
            "chunks": [
                366,
                20,
                40
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "|i1",
            "fill_value": null,
            "filters": null,
            "order": "C",
            "shape": [
                732,
                20,
                40
            ],
            "zarr_format": 2
        },
        "extreme_events/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "time",
                "lat",
                "lon"
            ],
            "dtype": "bool"
        },
        "lat/.zarray": {
            "chunks": [
                3600
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 7,
                "cname": "zstd",
                "id": "blosc",
                "shuffle": 2
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                20
            ],
            "zarr_format": 2
        },
        "lat/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lat"
            ],
            "axis": "Y",
            "comment": " Latitude geographical coordinates,WGS84 projection",
            "long_name": "latitude",
            "standard_name": "latitude",
            "units": "degrees_north",
            "valid_max": 90.0,
            "valid_min": -90.0
        },
        "lon/.zarray": {
            "chunks": [
                40
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                40
            ],
            "zarr_format": 2
        },
        "lon/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lon"
            ],
            "axis": "X",
            "comment": " Longitude geographical coordinates,WGS84 projection",
            "long_name": "longitude",
            "standard_name": "longitude",
            "units": "degrees_east",
            "valid_max": 180.0,
            "valid_min": -180.0
        },
        "mask/.zarray": {
            "chunks": [
                20,
                40
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "|i1",
            "fill_value": null,
            "filters": null,
            "order": "C",
            "shape": [
                20,
                40
            ],
            "zarr_format": 2
        },
        "mask/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lat",
                "lon"
            ],
            "comment": " OSTIA foundation SST",
            "dtype": "bool",
            "long_name": "analysed sea surface temperature",
            "reference": "C.J. Donlon, M. Martin,J.D. Stark, J. Roberts-Jones, E. Fiedler, W. Wimmer. The operational sea surface temperature and sea ice analysis (OSTIA) system. Remote Sensing Environ., 116 (2012), pp. 140-158 http://dx.doi.org/10.1016/j.rse.2010.10.017",
            "source": "AMSR2-REMSS-L2P-v2.0, AMSRE-REMSS-L2P-v2.0, TMI-REMSS-L2P-v04, GOES13-OSISAF-L3C-v2.0, SEVIRI-OSISAF-L3C-v2.0, SLSTRA-C3S-L3C-v2.0, ATSR<1,2>-ESACCI-L3U-v2.0, AATSR-ESACCI-L3U-v2.0, AVHRR<06,07,08,09,10,11,12,14,15,16,17,18,19>-ESACCI-L3U-v2.0, AVHRRMTA-ESACCI-L3U-v2.0, GMI-REMSS-L3U-v2.0, VIIRS-OSPO-L3U-v2.0",
            "standard_name": "sea_surface_foundation_temperature",
            "units": "kelvin",
            "valid_max": 4500,
            "valid_min": -300
        },
        "thresholds/.zarray": {
            "chunks": [
                10,
                20,
                366
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<f4",
            "fill_value": "NaN",
            "filters": null,
            "order": "C",
            "shape": [
                20,
                40,
                366
            ],
            "zarr_format": 2
        },
        "thresholds/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "lat",
                "lon",
                "dayofyear"
            ]
        },
        "time/.zarray": {
            "chunks": [
                10
            ],
            "compressor": {
                "blocksize": 0,
                "clevel": 5,
                "cname": "lz4",
                "id": "blosc",
                "shuffle": 1
            },
            "dtype": "<i4",
            "fill_value": null,
            "filters": null,
            "order": "C",
            "shape": [
                732
            ],
            "zarr_format": 2
        },
        "time/.zattrs": {
            "_ARRAY_DIMENSIONS": [
                "time"
            ],
            "axis": "T",
            "calendar": "proleptic_gregorian",
            "comment": "",
            "long_name": "reference time of sst field",
            "standard_name": "time",
            "units": "seconds since 1981-01-01"
        }
    },
    "zarr_consolidated_format": 1
}